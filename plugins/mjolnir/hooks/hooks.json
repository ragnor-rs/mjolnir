{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/boundary.py", "hook"],
            "timeout": 10,
            "statusMessage": "Holding what may leave the project"
          },
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/spend.py", "guard"],
            "timeout": 10,
            "statusMessage": "Holding what spends to somebody answering for it"
          },
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/live.py", "guard"],
            "timeout": 10,
            "statusMessage": "Holding what could reach a machine outside this one"
          },
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/enforce.py", "guard"],
            "timeout": 30,
            "statusMessage": "Reading the record this act is refused without"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/enforce.py", "release"],
            "timeout": 10,
            "statusMessage": "Giving back the place this call held"
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/load_the_rules.py"],
            "timeout": 10,
            "statusMessage": "Putting the rule this tree holds into the session"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/enforce.py", "release"],
            "timeout": 10,
            "statusMessage": "Giving back every place this session held"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/enforce.py", "release"],
            "timeout": 10,
            "statusMessage": "Giving back every place this subagent held"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/load_the_rules.py"],
            "timeout": 10,
            "statusMessage": "Putting the rules held by being read into the session"
          },
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/spend.py", "price"],
            "timeout": 10,
            "statusMessage": "Reading the one price stated before a turn runs"
          },
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/prune.py", "hook"],
            "timeout": 60,
            "statusMessage": "Reaping the trees whose branches have landed"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/check_reply_defers_nothing.py"],
            "timeout": 10,
            "statusMessage": "Holding the reply to leaving no work unfinished"
          },
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/enforce.py", "release"],
            "timeout": 10,
            "statusMessage": "Giving back every place the turn left held"
          }
        ]
      }
    ]
  }
}
